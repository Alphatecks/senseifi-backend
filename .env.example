# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/senseifi_db

# Server Configuration
PORT=3000
HOST=0.0.0.0
RUST_LOG=info
# CORS allowlist (comma-separated, no trailing slashes)
# Example production value:
# ALLOWED_ORIGINS=https://senseifi.io,https://www.senseifi.io
ALLOWED_ORIGINS=

# API Configuration (if needed)
# API_KEY=your_api_key_here

# BoomFi subscription billing (crypto, monthly lump charges)
# From BoomFi Merchant Dashboard → Organization settings + Developer → API Keys
BOOMFI_ORG_ID=
BOOMFI_WEBHOOK_PUBLIC_KEY=
# Hosted checkout paylink URLs (one per plan SKU — copy from BoomFi dashboard)
BOOMFI_PAYLINK_BASIC_MONTHLY=
BOOMFI_PAYLINK_BASIC_ANNUAL=
BOOMFI_PAYLINK_PRO_MONTHLY=
BOOMFI_PAYLINK_PRO_ANNUAL=
BOOMFI_PAYLINK_PREMIUM_MONTHLY=
BOOMFI_PAYLINK_PREMIUM_ANNUAL=
# Optional: BoomFi plan IDs for webhook → plan mapping
BOOMFI_PLAN_BASIC_MONTHLY=
BOOMFI_PLAN_BASIC_ANNUAL=
BOOMFI_PLAN_PRO_MONTHLY=
BOOMFI_PLAN_PRO_ANNUAL=
BOOMFI_PLAN_PREMIUM_MONTHLY=
BOOMFI_PLAN_PREMIUM_ANNUAL=
# Display prices for GET /api/subscriptions/plans (optional; code defaults match product UI)
BOOMFI_PRICE_BASIC_MONTHLY=15
BOOMFI_PRICE_BASIC_ANNUAL=150
BOOMFI_PRICE_PRO_MONTHLY=30
BOOMFI_PRICE_PRO_ANNUAL=300
BOOMFI_PRICE_PREMIUM_MONTHLY=200
BOOMFI_PRICE_PREMIUM_ANNUAL=2000
BOOMFI_SUCCESS_URL=http://localhost:3000/billing/success
BOOMFI_CANCEL_URL=http://localhost:3000/billing/cancel
# BoomFi hosted subscription management page for your org
BOOMFI_SUBSCRIPTION_PORTAL_URL=https://pay.boomfi.xyz/subscriptions

# XP (waitlist + usage billing)
XP_WELCOME_BONUS=100
XP_USAGE_BILLING_ENABLED=true
XP_COST_PER_USAGE=1
