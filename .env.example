# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/senseifi_db

# Server Configuration
PORT=3000
HOST=0.0.0.0
RUST_LOG=info
# CORS allowlist (comma-separated, no trailing slashes)
# Example production value:
# ALLOWED_ORIGINS=https://senseifi.io,https://www.senseifi.io
ALLOWED_ORIGINS=

# API Configuration (if needed)
# API_KEY=your_api_key_here

# Stripe Subscription Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_PRO_PLUS_MONTHLY=
STRIPE_PRICE_PRO_PLUS_ANNUAL=
STRIPE_PRICE_PREMIUM_MONTHLY=
STRIPE_PRICE_PREMIUM_ANNUAL=
# Backward compatibility fallbacks for monthly (optional):
# STRIPE_PRICE_PRO=
# STRIPE_PRICE_PRO_PLUS=
# STRIPE_PRICE_PREMIUM=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_BILLING_PORTAL_RETURN_URL=http://localhost:3000/settings/billing

# Onchain Subscription Billing (Non-custodial, Base USDC)
# Rollout controls
PAYMENTS_ONCHAIN_ENABLED=false
PAYMENTS_ONCHAIN_SHADOW_MODE=true
PAYMENTS_ALLOW_STRIPE_CHECKOUT=true
PAYMENTS_ALLOW_STRIPE_WEBHOOK=true

# Base network + contract integration (use 84532 for Base Sepolia testnet)
ONCHAIN_BASE_CHAIN_ID=8453
ONCHAIN_USDC_CONTRACT=
ONCHAIN_PAYMENT_CONTRACT=

# USD list prices for GET /api/payments/plans and POST /api/payments/onchain-subscribe (optional; code defaults match product UI)
ONCHAIN_PRICE_PRO_MONTHLY=30
ONCHAIN_PRICE_PRO_ANNUAL=300
ONCHAIN_PRICE_PRO_PLUS_MONTHLY=50
ONCHAIN_PRICE_PRO_PLUS_ANNUAL=500
ONCHAIN_PRICE_PREMIUM_MONTHLY=200
ONCHAIN_PRICE_PREMIUM_ANNUAL=2000

# Relayer integration for auto-pull charge submission (see relayer/README.md)
# Base URL only — backend appends /charge. Example: https://senseifi-relayer.onrender.com
ONCHAIN_RELAYER_URL=
ONCHAIN_RELAYER_API_KEY=

# Webhook and internal job auth
ONCHAIN_BASE_INDEXER_WEBHOOK_TOKEN=
ONCHAIN_PAYMENT_CONTRACT_WEBHOOK_TOKEN=
ONCHAIN_INTERNAL_JOB_TOKEN=

# XP (waitlist + usage billing)
XP_WELCOME_BONUS=100
XP_USAGE_BILLING_ENABLED=true
XP_COST_PER_USAGE=1
