# HTTP server (Render sets PORT automatically)
PORT=8080

# Must match ONCHAIN_RELAYER_API_KEY on the Senseifi backend
RELAYER_API_KEY=change-me-to-a-long-random-secret

# Operator wallet private key:
# - biller contract (live Sepolia): must be an allowed biller (e.g. 0x63D7... set at deploy)
# - relayer contract (in-repo): must be an allowed relayer
RELAYER_PRIVATE_KEY=0x

# auto | biller | relayer — live 0xf4F1cB... on Sepolia uses biller
PAYMENT_CONTRACT_STYLE=auto

# Base Sepolia (84532) or Base mainnet (8453)
CHAIN_ID=84532
RPC_URL=https://sepolia.base.org

# Deployed SenseifiSubscriptionPayments address
PAYMENT_CONTRACT=0xf4F1cB3668Eb8D35897031623761C982c5A8D9B2
